# ==========================================
venv/
venv310/
env/
ENV/
.venv
venv*/

# ==========================================
# Python Cache & Compiled Files - Exclude
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.installed.cfg
*.egg
dist/
build/
develop-eggs/
.eggs/
lib/
lib64/

# ==========================================
# Environment Variables - Exclude (User creates)
# ==========================================
.env
.env.local
.env.*.local
.env.example

# ==========================================
# IDE & Editor - Exclude
# ==========================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.project
.pydevproject
.settings/
*.sublime-project
*.sublime-workspace

