# ==========================================

# User Uploads
static/uploads/
static/uploads/*

# Dataset (2GB+ - User downloads via script)
datasets/
datasets/raw/
datasets/raw/*
datasets/train/
datasets/train/*
datasets/test/
datasets/test/*

# Pre-trained Models (User downloads via script)
*.h5
*.keras
models/*.h5
models/*.keras
models/saved_model/
models/saved_model/*
models/plant_disease_model.h5

# ==========================================
# Logs & Temporary Files - Exclude
